# Pensieve COS archive credentials — copy to ~/.config/pensieve-mcp/cos.env
# and `chmod 600` it. NEVER commit a real version of this file.
#
# Create a CAM sub-account in your Tencent Cloud console with a custom policy
# scoped to ONLY this bucket (PutObject / GetObject / DeleteObject /
# HeadObject / GetBucket plus multipart actions). Do not use your root key.

COS_SECRET_ID=REPLACE_WITH_YOUR_TENCENT_COS_SECRET_ID
COS_SECRET_KEY=REPLACE_WITH_YOUR_TENCENT_COS_SECRET_KEY

# Region: ap-shanghai / ap-beijing / ap-guangzhou / ap-singapore / ...
COS_REGION=ap-shanghai

# Full bucket name (always ends with -<APPID>)
COS_BUCKET=pensieve-archive-1234567890

# Your APPID (the trailing number in COS_BUCKET)
COS_APPID=1234567890

# Per-device prefix in the bucket. Keep this UNIQUE per machine
# so multiple Macs can share one bucket without collision:
#   personal-mac, work-mac, mini-server, ...
PENSIEVE_DEVICE=personal-mac
