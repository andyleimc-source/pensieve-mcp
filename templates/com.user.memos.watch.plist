<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>ExitTimeOut</key>
	<integer>10</integer>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.user.memos.watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/memos</string>
		<string>watch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.memos/watch.stderr.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.memos/watch.stdout.log</string>
</dict>
</plist>
